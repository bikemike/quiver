<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkPaned" id="browser_hpaned">
    <property name="orientation">horizontal</property>
    <property name="wide-handle">1</property>
    <child>
      <object class="GtkPaned" id="browser_vpaned">
        <property name="orientation">vertical</property>
        <property name="wide-handle">1</property>
        <child>
          <object class="GtkNotebook" id="browser_notebook">
            <property name="scrollable">1</property>
          </object>
        </child>
        <child>
          <object class="QuiverImageView" id="browser_image_preview"/>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="browser_right_pane">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="browser_top_controls">
            <child>
              <object class="GtkEntry" id="browser_location_entry">
                <property name="visible">0</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="browser_view_menubutton">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="popover">
                  <object class="GtkPopoverMenu">
                    <property name="menu-model">
                      <menu>
                        <section>
                          <item>
                            <attribute name="label" translatable="yes">Sidebar</attribute>
                            <attribute name="action">browser.BrowserViewSidebar</attribute>
                          </item>
                          <item>
                            <attribute name="label" translatable="yes">Preview</attribute>
                            <attribute name="action">browser.BrowserViewPreview</attribute>
                          </item>
                        </section>
                      </menu>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkScale" id="browser_thumb_sizer">
                <property name="orientation">horizontal</property>
                <property name="draw-value">0</property>
                <property name="round-digits">0</property>
                <property name="width-request">100</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">20</property>
                    <property name="upper">256</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">10</property>
                    <property name="value">128</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="browser_icon_view_sw">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="child">
              <object class="QuiverIconView" id="browser_icon_view"/>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
