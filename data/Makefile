installdirs:
	for dir in "$(DESTDIR)$(desktopdir)" "$(DESTDIR)$(icons_128x128dir)" "$(DESTDIR)$(icons_22x22dir)" "$(DESTDIR)$(icons_24x24dir)" "$(DESTDIR)$(icons_26x26dir)" "$(DESTDIR)$(icons_32x32dir)" "$(DESTDIR)$(icons_48x48dir)" "$(DESTDIR)$(icons_64x54dir)" "$(DESTDIR)$(icons_64x64dir)" "$(DESTDIR)$(servicedir)" "$(DESTDIR)$(uidir)"; do \
	  test -z "$$dir" || $(MKDIR_P) "$$dir"; \
	done
