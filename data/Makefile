	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(icons_26x26dir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(icons_26x26dir)" || exit $$?; \
	done

