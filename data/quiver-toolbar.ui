<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!--
    Main application toolbar.

    The toolbar is a GtkBox made of two always-visible groups:
      * shared_box - the browser / viewer / map mode radio buttons
      * filter_box - the filter menu button and the clear-filter button
    The mode buttons are GtkToggleButtons bound in C++ to a shared radio action
    group, so the active mode stays visibly pressed.  Keeping every mode button
    visible lets the user switch directly between all three views.

    The "Recently Viewed" menu button (button_recent) is a standalone object in
    this file; C++ packs it into the headerbar END, immediately to the left of
    the preferences button, so it sits on the opposite side of the headerbar
    from the toolbar's mode controls.

    All icons are -symbolic variants so the headerbar stays monochrome and
    matches the GNOME style (Nautilus, etc.).
  -->
  <object class="GtkBox" id="QuiverToolbar">
    <property name="orientation">horizontal</property>
    <property name="spacing">2</property>

    <!-- ============ Mode controls (shown in every mode) ============ -->
    <child>
      <object class="GtkBox" id="shared_box">
        <property name="orientation">horizontal</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkToggleButton" id="button_uimode_browser">
            <property name="tooltip-text">Browse Images</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">folder-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="button_uimode_map">
            <property name="tooltip-text">Map</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">mark-location-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="button_uimode_viewer">
            <property name="tooltip-text">View Image</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">image-x-generic-symbolic</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- ================= Filter controls (all modes) ==================== -->
    <child>
      <object class="GtkBox" id="filter_box">
        <property name="orientation">horizontal</property>
        <property name="spacing">2</property>
      </object>
    </child>
  </object>

  <!-- "Recently Viewed" menu button.  Kept out of QuiverToolbar: it is a
       standalone widget parented at runtime into the headerbar end, to the
       left of the preferences button.  Its live menu model (GMenu) is set by
       QuiverImpl::RebuildRecentMenu(). -->
  <object class="GtkMenuButton" id="button_recent">
    <property name="icon-name">document-open-recent-symbolic</property>
    <property name="tooltip-text">Recently Viewed</property>
  </object>
</interface>
