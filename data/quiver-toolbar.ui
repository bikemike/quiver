<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!--
    Main application toolbar.

    The toolbar is a GtkBox made of three child boxes:
      * shared_box  - shown in both modes; holds the full-screen toggle on the
                      far left, before the per-mode controls
      * browser_box - shown only in browser mode
      * viewer_box  - shown only in viewer mode
    C++ code toggles browser_box / viewer_box visibility on state change, so
    each state's toolbar group is an independent, per-state container (its own
    "placeholder").  Because they are distinct boxes, unmerging one state never
    disturbs the other state's controls.

    Toggle buttons bind to stateful boolean actions so GtkToggleButton reflects
    the active state automatically.

    All icons are -symbolic variants so the headerbar stays monochrome and
    matches the GNOME style (Nautilus, etc.).
  -->
  <object class="GtkBox" id="QuiverToolbar">
    <property name="orientation">horizontal</property>
    <property name="spacing">2</property>

    <!-- ============ Shared controls (shown in both modes) ============ -->
    <child>
      <object class="GtkBox" id="shared_box">
        <property name="orientation">horizontal</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkToggleButton">
            <property name="action-name">quiver.FullScreen</property>
            <property name="tooltip-text">Toggle Full Screen Mode</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">view-fullscreen-symbolic</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- ===================== Browser-only controls ===================== -->
    <child>
      <object class="GtkBox" id="browser_box">
        <property name="orientation">horizontal</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkButton" id="button_uimode_viewer">
            <property name="action-name">quiver.UIModeViewer</property>
            <property name="tooltip-text">View Image</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">image-x-generic-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator">
            <property name="orientation">vertical</property>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="action-name">quiver.BrowserHistoryBack</property>
            <property name="tooltip-text">Go Back</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-previous-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="action-name">quiver.BrowserHistoryForward</property>
            <property name="tooltip-text">Go Forward</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-next-symbolic</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- ===================== Viewer-only controls ===================== -->
    <child>
      <object class="GtkBox" id="viewer_box">
        <property name="orientation">horizontal</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkButton" id="button_uimode_browser">
            <property name="action-name">quiver.UIModeBrowser</property>
            <property name="tooltip-text">Browse Images</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">folder-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator">
            <property name="orientation">vertical</property>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="action-name">quiver.ImagePrevious</property>
            <property name="tooltip-text">Go to previous image</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-previous-symbolic</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton">
            <property name="action-name">quiver.ImageNext</property>
            <property name="tooltip-text">Go to next image</property>
            <child>
              <object class="GtkImage">
                <property name="icon-name">go-next-symbolic</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>