<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="GtkWindow" id="BookmarkAddEditDialog">
    <property name="title" translatable="1">Add/Edit Bookmark</property>
    <child>
      <object class="GtkBox" id="dialog-vbox6">
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="hbox12">
            <property name="hexpand">1</property>
            <property name="spacing">10</property>
            <child>
              <object class="GtkBox" id="vbox24">
                <property name="orientation">vertical</property>
                <property name="width_request">200</property>
                <child>
                  <object class="GtkBox" id="vbox25">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="label21">
                        <property name="xalign">0</property>
                        <property name="label" translatable="1">&lt;b&gt;Name&lt;/b&gt;</property>
                        <property name="use_markup">1</property>
                        <property name="use_underline">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="bookmark_entry_name">
                        <property name="focusable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="vbox26">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="label22">
                        <property name="xalign">0</property>
                        <property name="label" translatable="1">&lt;b&gt;Description&lt;/b&gt;</property>
                        <property name="use_markup">1</property>
                        <property name="use_underline">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="bookmark_entry_description">
                        <property name="valign">center</property>
                        <property name="focusable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="vbox27">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel" id="label23">
                        <property name="xalign">0</property>
                        <property name="label" translatable="1">&lt;b&gt;Icon&lt;/b&gt;</property>
                        <property name="use_markup">1</property>
                        <property name="use_underline">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="bookmark_entry_icon">
                        <property name="focusable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="vbox23">
                <property name="orientation">vertical</property>
                <property name="hexpand">1</property>
                <property name="width_request">350</property>
                <property name="spacing">5</property>
                <child>
                  <object class="GtkLabel" id="label20">
                    <property name="valign">center</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="1">&lt;b&gt;Locations:&lt;/b&gt;</property>
                    <property name="use_markup">1</property>
                    <property name="justify">fill</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow2">
                    <property name="vexpand">1</property>
                    <property name="focusable">1</property>
                    <property name="child">
                      <object class="GtkColumnView" id="bookmark_treeview_locations">
                        <property name="focusable">1</property>
                        <property name="show_row_separators">0</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="bookmark_checkbutton_recursive">
                    <property name="label" translatable="1">include subfolders</property>
                    <property name="focusable">1</property>
                    <property name="use_underline">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="hbox13">
                    <property name="spacing">5</property>
                    <property name="homogeneous">1</property>
                    <child>
                      <object class="GtkButton" id="bookmark_button_add">
                        <property name="label">+</property>
                        <property name="focusable">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="bookmark_button_remove">
                        <property name="label">-</property>
                        <property name="focusable">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="BookmarksDialog">
