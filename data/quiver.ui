  <object class="GtkWindow" id="ExternalToolAddEditDialog">
    <property name="title" translatable="1">External Tool Editor</property>
    <child>
      <object class="GtkBox" id="dialog-vbox3">
        <child>
          <object class="GtkBox" id="vbox12">
