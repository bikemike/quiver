  <object class="GtkWindow" id="RenameDialog">
    <property name="title" translatable="1">Rename</property>
    <child>
      <object class="GtkBox" id="dialog-vbox12">
        <property name="spacing">2</property>
        <child>
          <object class="GtkGrid" id="table4">
            <property name="column-spacing">5</property>
            <property name="row-spacing">3</property>
            <child>
              <placeholder />
            </child>
            <child>
              <object class="GtkBox" id="rename_align_source_folder">
                <child>
                  <placeholder />
                </child>
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">0</property>
                  <property name="column-span">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="rename_label_example">
                <property name="xalign">0</property>
                <property name="use_markup">1</property>
                <property name="ellipsize">start</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">4</property>
                  <property name="column-span">2</property>
                </layout>
                <property name="margin-start">10</property>
                <property name="margin-end">10</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label34">
                <property name="xalign">0</property>
                <property name="label" translatable="1">Example Output:</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">3</property>
                  <property name="column-span">2</property>
                </layout>
                <property name="margin-top">10</property>
                <property name="margin-bottom">10</property>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="rename_entry_template">
                <property name="focusable">1</property>
                <property name="text" translatable="1">%Y-%m-%d %H.%M.%S-##</property>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label39">
                <property name="xalign">0</property>
                <property name="label" translatable="1">Template</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_tempate_options">
                <property name="xalign">0</property>
                <property name="label" translatable="1">Template variables:
%Y = Year, %m  = month, %d = day, 
%H = hour, %M = minute, %S = second
# = count (more # symbols will cause padding)</property>
                <attributes>
                  <attribute name="scale" value="0.75" />
                </attributes>
                <layout>
                  <property name="column">1</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
