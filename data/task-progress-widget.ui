<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="GtkBox" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">3</property>
    <child>
      <object class="GtkLabel" id="task_title_label">
        <property name="xalign">0</property>
        <attributes>
          <attribute name="weight" value="bold"></attribute>
        </attributes>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">5</property>
        <child>
          <object class="GtkImage" id="task_thumbnail_image">
            <property name="icon-size">large</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkLabel" id="task_details_label">
                <property name="xalign">0</property>
                <property name="ellipsize">middle</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">2</property>
                <child>
                  <object class="GtkProgressBar" id="task_progress_bar">
                    <property name="hexpand">1</property>
                    <property name="show-text">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="task_pause_button">
                    <property name="icon-name">media-playback-pause</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="task_cancel_button">
                    <property name="icon-name">process-stop</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="task_progress_details_label">
                <property name="xalign">0</property>
                <property name="ellipsize">middle</property>
                <attributes>
                  <attribute name="scale" value="small"></attribute>
                </attributes>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
